# ── Backend env (скопируй в .env и заполни) ──
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# JWT (64+ символов; refresh — отдельный секрет)
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=1h

# Postgres
DB_URL=postgresql://user:password@host:port/dbname

# Cloudinary — только имя аккаунта (загрузка идёт с фронта, unsigned)
CLOUDINARY_CLOUD_NAME=

# Email (Resend). Пусто = dev-режим: ссылки печатаются в консоль
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# Отдельная БД для автотестов (vitest). Должна содержать "polish_test" в имени —
# это защита от прогона sync({ force: true }) по боевой базе.
# Проще всего — локальный контейнер: npm run test:db:up (docker-compose.test.yml),
# тогда строка ниже подходит как есть. В CI база поднимается сама.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/polish_test

# Мониторинг ошибок Sentry (пусто = выключено)
SENTRY_DSN=

# ── Paddle (подписки) ──
# Developer tools → Notifications → destination → Edit destination → Secret key (pdl_ntfset_...).
# Без него вебхук отвечает 401 и тариф не обновляется.
PADDLE_WEBHOOK_SECRET=
# Price ID трёх платных тарифов (Catalog → Products → Prices), формат pri_...
# Должны совпадать с VITE_PADDLE_PRICE_* на фронте и быть из того же кабинета, что и секрет выше.
PADDLE_PRICE_BASIC=
PADDLE_PRICE_PRO=
PADDLE_PRICE_SCHOOL=
# API-ключ (Developer tools → Authentication → API keys), формат pdl_sdbx_apikey_... / pdl_live_apikey_...
# Нужен для «Управлять подпиской»: статус, дата списания, отмена. Без него /plans покажет
# тариф, но кнопки отмены не будет.
PADDLE_API_KEY=
# sandbox (по умолчанию) | production — определяет домен API Paddle. Должен совпадать
# со средой ключей выше и с VITE_PADDLE_ENV на фронте.
PADDLE_ENV=sandbox

# AI-генератор тестов (OpenAI-совместимый провайдер). Пусто = 503 «AI не настроен».
# По умолчанию — Groq (бесплатно): ключ на console.groq.com
AI_API_KEY=
# Необязательно (это дефолты — Groq + Llama 3.3 70B):
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=llama-3.3-70b-versatile
